{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Get tables",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "set",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Foldernames",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
